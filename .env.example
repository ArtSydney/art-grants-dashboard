# Copy to .env and fill in. .env is gitignored so your secrets never get committed.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Leave blank to skip Discord while testing locally.
DISCORD_WEBHOOK_URL=
# Optional. Get a free key at serper.dev (2,500 free searches).
# Leave blank to skip the Google search discovery source.
SERPER_API_KEY=
